NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# One Door card storage (optional — defaults to ~/storage/one-door)
# ONE_DOOR_DATA_DIR=/path/to/card/storage

# Vercel publishing (optional — without it, cards stay private links only)
# ONE_DOOR_VERCEL_TOKEN=your_vercel_token
# ONE_DOOR_VERCEL_PROJECT=one-door-cards

